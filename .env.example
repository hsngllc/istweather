# İstanbul Hava — ortam değişkenleri örneği
#
# Kullanım: bu dosyayı `.env` adıyla kopyalayın ve boş değerleri doldurun.
# `.env` git'e girmez. Anahtar, şifre ve token'ları sohbette, issue'larda veya
# commit'lerde paylaşmayın; yalnızca `.env` dosyasına yazın.

# -----------------------------------------------------------------------------
# Geçmiş model arşivleri (proje sahibi hesap açar)
# -----------------------------------------------------------------------------

# TIGGE — ECMWF Data Store (ECDS). `ecmwf-datastores-client` bu iki değişkeni
# doğrudan okur. Anahtar: ECDS'ye giriş yapıp https://ecds.ecmwf.int/how-to-api sayfasındaki
# kişisel erişim anahtarı (key). TIGGE lisansı tigge-forecasts sayfasında, Download sekmesinin
# en altında bir kez kabul edilir.
# Ticari kullanıma yalnız DWD, ECCC, ECMWF, KMA, NCEP ve UKMO verisi açıktır (CC BY 4.0).
ECMWF_DATASTORES_URL=https://ecds.ecmwf.int/api
ECMWF_DATASTORES_KEY=

# Hugging Face — OCF ICON arşivleri (openclimatefix/dwd-icon-eu, dwd-icon-global).
# `huggingface_hub` bu değişkeni doğrudan okur. "Read" yetkili bir User Access Token
# yeterlidir; veri setlerinin sayfasında erişim onayı ayrıca istenmelidir.
HF_TOKEN=

# İki hesabı anahtarları yazdırmadan denetlemek için:
#   docker compose run --rm --no-deps worker python -m hava.ops.accounts_check

# -----------------------------------------------------------------------------
# Veritabanı (PostgreSQL + TimescaleDB) — Faz 1
# -----------------------------------------------------------------------------
POSTGRES_DB=hava
POSTGRES_USER=hava
# Zorunlu: TimescaleDB konteyneri boş şifreyle başlamaz.
POSTGRES_PASSWORD=
# Uygulamanın bağlandığı adres (compose içinde servis adı `db`)
HAVA_DB_HOST=db
HAVA_DB_PORT=5432

# -----------------------------------------------------------------------------
# Uygulama
# -----------------------------------------------------------------------------
# dev | prod
HAVA_ENV=dev
# Dış servislere gönderilen tanımlayıcı User-Agent (AWC ve IEM istiyor).
# İletişim olarak proje adresi kullanılıyor; kişisel e-posta yazmak gerekmez.
HAVA_HTTP_USER_AGENT=istweather/0.1 (+https://github.com/hsngllc/istweather)
# Geliştirmede API'nin bilgisayarda açıldığı port (konteyner içinde her zaman 8000).
# 8000'i başka bir program kullanıyorsa değiştirin.
HAVA_API_PORT=8000
# Sitenin alan adı (CORS); virgülle birden fazla
HAVA_CORS_ORIGINS=http://localhost:3000
# Üretimde Caddy'nin HTTPS sertifikası alacağı alan adı (ör. api.ornek.com); geliştirmede boş.
HAVA_DOMAIN=

# Admin paneli (tek kullanıcı)
HAVA_ADMIN_USERNAME=admin
HAVA_ADMIN_PASSWORD=

# MGM adaptörü: doğrudan kullanım iptal edildi (2026-11-01). Yalnızca resmî
# izin/MEVBİS lisansıyla veri gelirse açılır.
HAVA_MGM_ENABLED=false

# -----------------------------------------------------------------------------
# Gözlem (METAR) — Faz 2
# -----------------------------------------------------------------------------
# Varsayılanlar kodda; yalnız değiştirmek gerekirse açın. Adresi geçersiz bir yere
# çevirmek kaynak kapatma denemesi (bildirim testi) için kullanılabilir.
# HAVA_METAR_AWC_URL=https://aviationweather.gov/api/data/metar
# HAVA_METAR_IEM_URL=https://mesonet.agron.iastate.edu/cgi-bin/request/asos.py
# İstasyonun son gözlemi bu kadar dakikadan eskiyse kaynak "bayat" sayılır.
# HAVA_METAR_STALE_MINUTES=90
# AWC'den bu kadar dakikadır başarılı yanıt alınamıyorsa toplayıcı "bayat" sayılır.
# HAVA_AWC_FETCH_STALE_MINUTES=30

# -----------------------------------------------------------------------------
# Bildirimler (veri akışı durursa) — Faz 2+
# -----------------------------------------------------------------------------
# Telegram: @BotFather ile bot açın; token'ı ve botun mesaj atacağı sohbetin kimliğini yazın.
HAVA_TELEGRAM_BOT_TOKEN=
HAVA_TELEGRAM_CHAT_ID=
# E-posta (STARTTLS). Gönderen boşsa HAVA_SMTP_USER kullanılır.
HAVA_SMTP_HOST=
HAVA_SMTP_PORT=587
HAVA_SMTP_USER=
HAVA_SMTP_PASSWORD=
HAVA_SMTP_FROM=
HAVA_ALERT_EMAIL_TO=
