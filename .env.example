# İstanbul Hava — ortam değişkenleri örneği
#
# Kullanım: bu dosyayı `.env` adıyla kopyalayın ve boş değerleri doldurun.
# `.env` git'e girmez. Anahtar, şifre ve token'ları sohbette, issue'larda veya
# commit'lerde paylaşmayın; yalnızca `.env` dosyasına yazın.

# -----------------------------------------------------------------------------
# Geçmiş model arşivleri (proje sahibi hesap açar)
# -----------------------------------------------------------------------------

# TIGGE — ECMWF Data Store (ECDS). `ecmwf-datastores-client` bu iki değişkeni
# doğrudan okur. Anahtar: ECDS hesabınızın profil sayfasındaki API anahtarı.
# TIGGE lisansının ECDS'de bir kez kabul edilmesi gerekir (tigge-forecasts).
# Ticari kullanıma yalnız DWD, ECCC, ECMWF, KMA, NCEP ve UKMO verisi açıktır (CC BY 4.0).
ECMWF_DATASTORES_URL=https://ecds.ecmwf.int/api
ECMWF_DATASTORES_KEY=

# Hugging Face — OCF ICON arşivleri (openclimatefix/dwd-icon-eu, dwd-icon-global).
# `huggingface_hub` bu değişkeni doğrudan okur. "Read" yetkili bir User Access Token
# yeterlidir; veri setlerinin sayfasında erişim onayı ayrıca istenmelidir.
HF_TOKEN=

# -----------------------------------------------------------------------------
# Veritabanı (PostgreSQL + TimescaleDB) — Faz 1
# -----------------------------------------------------------------------------
POSTGRES_DB=hava
POSTGRES_USER=hava
POSTGRES_PASSWORD=
# Uygulamanın bağlandığı adres (compose içinde servis adı `db`)
HAVA_DB_HOST=db
HAVA_DB_PORT=5432

# -----------------------------------------------------------------------------
# Uygulama
# -----------------------------------------------------------------------------
# dev | prod
HAVA_ENV=dev
# Dış servislere gönderilen tanımlayıcı User-Agent (AWC ve IEM istiyor).
# İletişim adresi olarak bir e-posta veya URL yazın.
HAVA_HTTP_USER_AGENT=istweather/0.1 (+contact: )
# Sitenin alan adı (CORS); virgülle birden fazla
HAVA_CORS_ORIGINS=http://localhost:3000

# Admin paneli (tek kullanıcı)
HAVA_ADMIN_USERNAME=admin
HAVA_ADMIN_PASSWORD=

# MGM adaptörü: doğrudan kullanım iptal edildi (2026-11-01). Yalnızca resmî
# izin/MEVBİS lisansıyla veri gelirse açılır.
HAVA_MGM_ENABLED=false

# -----------------------------------------------------------------------------
# Bildirimler (veri akışı durursa) — Faz 2+
# -----------------------------------------------------------------------------
HAVA_TELEGRAM_BOT_TOKEN=
HAVA_TELEGRAM_CHAT_ID=
HAVA_SMTP_HOST=
HAVA_SMTP_PORT=587
HAVA_SMTP_USER=
HAVA_SMTP_PASSWORD=
HAVA_ALERT_EMAIL_TO=
