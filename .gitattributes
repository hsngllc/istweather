# Tüm metin dosyalarında satır sonu LF (Windows'ta da). Konteynerler Linux'tur.
* text=auto eol=lf

# Windows'a özgü betikler CRLF kalır
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# İkili dosyalar
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.bz2 binary
*.parquet binary
*.grib binary
*.grib2 binary
*.grb2 binary
*.nc binary
*.h5 binary
